{
  "name": "lisiere",
  "main": "worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/robots.txt",
      "/sitemap.xml",
      "/google*.html",
      "/"
    ]
  }
}
