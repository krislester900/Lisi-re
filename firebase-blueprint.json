            "model",
            "verdict",
            "confidencePercent",
            "recommendedAction",
            "suggestedGravity",
            "suggestedCriteria",
            "summary",
            "suggestedDecisionReason",
            "needsAdminIntervention",
            "interventionReason"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
