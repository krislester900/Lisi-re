rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSalonId(salonId) {
      return salonId in ['creation', 'rencontres', 'solitudes', 'premiers-elans', 'quotidien', 'faq'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminEmail() {
      return isVerifiedUser()
        && request.auth.token.email == 'krislester900@gmail.com';
    }

    function isBlockedBetween(uidA, uidB) {
      return (
        exists(/databases/$(database)/documents/users/$(uidA)/relationships/$(uidB))
        && get(/databases/$(database)/documents/users/$(uidA)/relationships/$(uidB)).data.relation == 'blocked'
      ) || (
        exists(/databases/$(database)/documents/users/$(uidB)/relationships/$(uidA))
        && get(/databases/$(database)/documents/users/$(uidB)/relationships/$(uidA)).data.relation == 'blocked'
      );
    }

    function isApprovedCustomSalonMember(salonId) {
      return isSignedIn()
        && isValidId(salonId)
        && exists(/databases/$(database)/documents/customSalons/$(salonId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/customSalons/$(salonId)/members/$(request.auth.uid)).data.status == 'approved';
    }

    function canReadStoryData(storyData) {
      return storyData.visibility == 'public'
        || (isSignedIn() && storyData.authorId == request.auth.uid)
        || (
          isSignedIn()
          && 'customSalonId' in storyData
          && storyData.customSalonVisibility == 'private'
          && isApprovedCustomSalonMember(storyData.customSalonId)
        );
    }

    function meetsStoryFormatMinLength(data) {
      return (
        ('storyFormat' in data && data.storyFormat == 'roman')
          ? data.content.size() >= 3000
          : data.content.size() >= 160
      );
    }

    // --- Validation Blueprints ---
    function isValidPublicProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'bio', 'listeningNote', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'displayName', 'bio', 'listeningNote',
          'favoriteTrackTitle', 'favoriteTrackArtist', 'favoriteTrackUrl',
          'favoriteNovel', 'interests', 'avatarUrl', 'discoverable',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.bio is string && data.bio.size() <= 320
        && data.listeningNote is string && data.listeningNote.size() <= 200
        && (!('favoriteTrackTitle' in data) || (data.favoriteTrackTitle is string && data.favoriteTrackTitle.size() <= 120))
        && (!('favoriteTrackArtist' in data) || (data.favoriteTrackArtist is string && data.favoriteTrackArtist.size() <= 100))
        && (!('favoriteTrackUrl' in data) || (data.favoriteTrackUrl is string && data.favoriteTrackUrl.size() <= 500))
        && (!('favoriteNovel' in data) || (data.favoriteNovel is string && data.favoriteNovel.size() <= 140))
        && (!('interests' in data) || (data.interests is string && data.interests.size() <= 240))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 60000))
        && (!('discoverable' in data) || data.discoverable is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWallItem(data) {
      return data.keys().hasAll([
          'itemId', 'ownerId', 'ownerName', 'visibility', 'kind',
          'title', 'subtitle', 'body', 'mediaUrl', 'accentTone',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'itemId', 'ownerId', 'ownerName', 'visibility', 'kind',
          'title', 'subtitle', 'body', 'mediaUrl', 'accentTone',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.itemId)
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 60
        && data.visibility == 'public'
        && data.kind in ['photo', 'music', 'novel', 'note']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.subtitle is string && data.subtitle.size() <= 140
        && data.body is string && data.body.size() <= 600
        && data.mediaUrl is string && data.mediaUrl.size() <= 160000
        && data.accentTone in ['ink', 'ochre', 'terracotta', 'sage', 'sand']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'email', 'declaredAge', 'birthYear', 'ageUpdatedAt',
          'favoriteThemes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('declaredAge' in data) || (data.declaredAge is int && data.declaredAge >= 13 && data.declaredAge <= 115))
        && (!('birthYear' in data) || (data.birthYear is int && data.birthYear >= 1900 && data.birthYear <= 2026))
        && (!('ageUpdatedAt' in data) || data.ageUpdatedAt is timestamp)
        && (!('favoriteThemes' in data) || (
          data.favoriteThemes is list
          && data.favoriteThemes.size() <= 6
          && (data.favoriteThemes.size() < 1 || isValidSalonId(data.favoriteThemes[0]))
          && (data.favoriteThemes.size() < 2 || isValidSalonId(data.favoriteThemes[1]))
          && (data.favoriteThemes.size() < 3 || isValidSalonId(data.favoriteThemes[2]))
          && (data.favoriteThemes.size() < 4 || isValidSalonId(data.favoriteThemes[3]))
          && (data.favoriteThemes.size() < 5 || isValidSalonId(data.favoriteThemes[4]))
          && (data.favoriteThemes.size() < 6 || isValidSalonId(data.favoriteThemes[5]))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll([
          'userId', 'storyId', 'storyTitle', 'storyExcerpt', 'storyAuthorId',
          'storyAuthorName', 'storyTheme', 'readingMinutes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'storyId', 'storyTitle', 'storyExcerpt', 'storyAuthorId',
          'storyAuthorName', 'storyTheme', 'customSalonId', 'customSalonName',
          'storyScope', 'storyFormat', 'readingMinutes', 'createdAt'
        ])
        && isValidId(data.userId)
        && isValidId(data.storyId)
        && data.storyTitle is string && data.storyTitle.size() >= 1 && data.storyTitle.size() <= 140
        && data.storyExcerpt is string && data.storyExcerpt.size() <= 300
        && isValidId(data.storyAuthorId)
        && data.storyAuthorName is string && data.storyAuthorName.size() >= 2 && data.storyAuthorName.size() <= 60
        && isValidSalonId(data.storyTheme)
        && (!('customSalonId' in data) || isValidId(data.customSalonId))
        && (!('customSalonName' in data) || (data.customSalonName is string && data.customSalonName.size() <= 80))
        && (!('storyScope' in data) || data.storyScope in ['salon', 'pelemele'])
        && (!('storyFormat' in data) || data.storyFormat in ['confession', 'roman'])
        && data.readingMinutes is int && data.readingMinutes >= 1 && data.readingMinutes <= 60
        && data.createdAt is timestamp;
    }

    function isValidQuote(data) {
      return data.keys().hasAll([
          'quoteId', 'userId', 'storyId', 'chapterNumber', 'paragraphIndex',
          'quoteText', 'storyTitle', 'storyAuthorId', 'storyAuthorName',
          'storyTheme', 'createdAt'
        ])
        && data.keys().hasOnly([
          'quoteId', 'userId', 'storyId', 'chapterNumber', 'chapterTitle',
          'paragraphIndex', 'quoteText', 'storyTitle', 'storyAuthorId',
          'storyAuthorName', 'storyTheme', 'customSalonId', 'customSalonName',
          'storyScope', 'storyFormat', 'createdAt'
        ])
        && isValidId(data.quoteId)
        && isValidId(data.userId)
        && isValidId(data.storyId)
        && data.chapterNumber is int && data.chapterNumber >= 1 && data.chapterNumber <= 500
        && (!('chapterTitle' in data) || (data.chapterTitle is string && data.chapterTitle.size() >= 1 && data.chapterTitle.size() <= 140))
        && data.paragraphIndex is int && data.paragraphIndex >= 0 && data.paragraphIndex <= 5000
        && data.quoteText is string && data.quoteText.size() >= 3 && data.quoteText.size() <= 800
        && data.storyTitle is string && data.storyTitle.size() >= 1 && data.storyTitle.size() <= 140
        && isValidId(data.storyAuthorId)
        && data.storyAuthorName is string && data.storyAuthorName.size() >= 2 && data.storyAuthorName.size() <= 60
        && isValidSalonId(data.storyTheme)
        && (!('customSalonId' in data) || isValidId(data.customSalonId))
        && (!('customSalonName' in data) || (data.customSalonName is string && data.customSalonName.size() <= 80))
        && (!('storyScope' in data) || data.storyScope in ['salon', 'pelemele'])
        && (!('storyFormat' in data) || data.storyFormat in ['confession', 'roman'])
        && data.createdAt is timestamp;
    }

    function isValidRepost(data) {
      return data.keys().hasAll([
          'repostId', 'reposterId', 'reposterName', 'storyId', 'storyTitle',
          'storyExcerpt', 'storyAuthorId', 'storyAuthorName', 'storyTheme',
          'readingMinutes', 'note', 'visibility', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'repostId', 'reposterId', 'reposterName', 'storyId', 'storyTitle',
          'storyExcerpt', 'storyAuthorId', 'storyAuthorName', 'storyTheme',
          'customSalonId', 'customSalonName', 'storyScope', 'storyFormat',
          'readingMinutes', 'note', 'visibility', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.repostId)
        && isValidId(data.reposterId)
        && data.reposterName is string && data.reposterName.size() >= 2 && data.reposterName.size() <= 60
        && isValidId(data.storyId)
        && data.storyTitle is string && data.storyTitle.size() >= 1 && data.storyTitle.size() <= 140
        && data.storyExcerpt is string && data.storyExcerpt.size() <= 300
        && isValidId(data.storyAuthorId)
        && data.storyAuthorName is string && data.storyAuthorName.size() >= 2 && data.storyAuthorName.size() <= 60
        && isValidSalonId(data.storyTheme)
        && (!('customSalonId' in data) || isValidId(data.customSalonId))
        && (!('customSalonName' in data) || (data.customSalonName is string && data.customSalonName.size() <= 80))
        && (!('storyScope' in data) || data.storyScope in ['salon', 'pelemele'])
        && (!('storyFormat' in data) || data.storyFormat in ['confession', 'roman'])
        && data.readingMinutes is int && data.readingMinutes >= 1 && data.readingMinutes <= 60
        && data.note is string && data.note.size() <= 280
        && data.visibility in ['public', 'private']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStory(data) {
      return data.keys().hasAll([
          'storyId', 'authorId', 'authorName', 'title', 'excerpt', 'content',
          'theme', 'promptQuestion', 'visibility', 'readingMinutes',
          'resonanceCount', 'echoCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storyId', 'authorId', 'authorName', 'title', 'excerpt', 'content',
          'theme', 'customSalonId', 'customSalonName', 'customSalonVisibility', 'storyScope',
          'storyFormat', 'novelGenre', 'coverUrl', 'plagiarismAttested',
          'releaseCadence', 'seriesStatus',
          'chapterCount', 'lastChapterId', 'promptQuestion', 'visibility', 'isAnonymous',
          'minAge', 'isMature', 'matureReason', 'charterAttested',
          'readingMinutes', 'resonanceCount', 'echoCount', 'lastEchoId',
          'viewCount', 'lastViewId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.storyId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.excerpt is string && data.excerpt.size() >= 10 && data.excerpt.size() <= 300
        && data.content is string && data.content.size() >= 20 && data.content.size() <= 8000
        && isValidSalonId(data.theme)
        && (!('customSalonId' in data) || isValidId(data.customSalonId))
        && (!('customSalonName' in data) || (data.customSalonName is string && data.customSalonName.size() >= 3 && data.customSalonName.size() <= 80))
        && (!('customSalonVisibility' in data) || data.customSalonVisibility in ['public', 'private'])
        && (!('storyScope' in data) || data.storyScope in ['salon', 'pelemele'])
        && (!('storyFormat' in data) || data.storyFormat in ['confession', 'roman'])
        && (!('novelGenre' in data) || data.novelGenre in ['poeme', 'drame', 'romance', 'historique', 'fantastique', 'polar', 'contemporain', 'essai', 'autre'])
        && (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 160000))
        && (!('plagiarismAttested' in data) || data.plagiarismAttested is bool)
        && (!('releaseCadence' in data) || data.releaseCadence in ['unique', 'hebdomadaire', 'bihebdomadaire', 'libre'])
        && (!('seriesStatus' in data) || data.seriesStatus in ['complet', 'en-cours', 'termine'])
        && (!('chapterCount' in data) || (data.chapterCount is int && data.chapterCount >= 0 && data.chapterCount <= 500))
        && (!('lastChapterId' in data) || isValidId(data.lastChapterId))
        && data.promptQuestion is string && data.promptQuestion.size() <= 240
        && data.visibility in ['public', 'private']
        && (!('isAnonymous' in data) || data.isAnonymous is bool)
        && (!('minAge' in data) || (data.minAge is int && data.minAge in [0, 13, 16, 18]))
        && (!('isMature' in data) || data.isMature is bool)
        && (!('matureReason' in data) || (data.matureReason is string && data.matureReason.size() <= 180))
        && (!('charterAttested' in data) || data.charterAttested is bool)
        && data.readingMinutes is int && data.readingMinutes >= 1 && data.readingMinutes <= 60
        && data.resonanceCount is int && data.resonanceCount >= 0
        && data.echoCount is int && data.echoCount >= 0
        && (!('lastEchoId' in data) || isValidId(data.lastEchoId))
        && (!('viewCount' in data) || (data.viewCount is int && data.viewCount >= 0))
        && (!('lastViewId' in data) || isValidId(data.lastViewId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChapter(data) {
      return data.keys().hasAll([
          'chapterId', 'storyId', 'authorId', 'storyVisibility',
          'chapterNumber', 'title', 'content', 'authorNote',
          'readingMinutes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'chapterId', 'storyId', 'authorId', 'storyVisibility',
          'chapterNumber', 'title', 'content', 'authorNote',
          'readingMinutes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.chapterId)
        && isValidId(data.storyId)
        && isValidId(data.authorId)
        && data.storyVisibility in ['public', 'private']
        && data.chapterNumber is int && data.chapterNumber >= 1 && data.chapterNumber <= 500
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.content is string && data.content.size() >= 20 && data.content.size() <= 12000
        && data.authorNote is string && data.authorNote.size() <= 400
        && data.readingMinutes is int && data.readingMinutes >= 1 && data.readingMinutes <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidResonance(data) {
      return data.keys().hasAll(['userId', 'storyId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'storyId', 'authorId', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.storyId)
        && (!('authorId' in data) || isValidId(data.authorId))
        && data.createdAt is timestamp;
    }

    function isValidStoryView(data) {
      return data.keys().hasAll(['viewId', 'storyId', 'authorId', 'viewerId', 'dateKey', 'createdAt'])
        && data.keys().hasOnly(['viewId', 'storyId', 'authorId', 'viewerId', 'dateKey', 'createdAt'])
        && isValidId(data.viewId)
        && isValidId(data.storyId)
        && isValidId(data.authorId)
        && isValidId(data.viewerId)
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    function isValidEcho(data) {
      return data.keys().hasAll([
          'echoId', 'storyId', 'storyVisibility', 'authorId', 'authorName',
          'replyType', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'echoId', 'storyId', 'storyVisibility', 'authorId', 'authorName',
          'replyType', 'content', 'createdAt'
        ])
        && isValidId(data.echoId)
        && isValidId(data.storyId)
        && data.storyVisibility == 'public'
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60
        && data.replyType in ['comment', 'resonance', 'question', 'experience']
        && data.content is string && data.content.size() >= 2 && data.content.size() <= 1500
        && data.createdAt is timestamp;
    }

    function isValidPlagiarismReport(data) {
      return data.keys().hasAll([
          'storyId', 'reporterId', 'reporterName', 'reason', 'details', 'referenceUrl', 'createdAt'
        ])
        && data.keys().hasOnly([
          'storyId', 'reporterId', 'reporterName', 'reason', 'details', 'referenceUrl', 'createdAt'
        ])
        && isValidId(data.storyId)
        && isValidId(data.reporterId)
        && data.reporterName is string && data.reporterName.size() >= 2 && data.reporterName.size() <= 60
        && data.reason in ['copie-interne', 'oeuvre-publiee', 'autre']
        && data.details is string && data.details.size() >= 10 && data.details.size() <= 600
        && data.referenceUrl is string && data.referenceUrl.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidSalonMessage(data) {
      return data.keys().hasAll([
          'messageId', 'salonId', 'senderId', 'senderName', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'messageId', 'salonId', 'senderId', 'senderName', 'content', 'createdAt'
        ])
        && isValidId(data.messageId)
        && isValidSalonId(data.salonId)
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 60
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidCustomSalon(data) {
      return data.keys().hasAll([
          'salonId', 'name', 'description', 'promptQuestion', 'admissionRules',
          'visibility', 'ownerId', 'ownerName', 'accentTone', 'memberCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'salonId', 'name', 'description', 'promptQuestion', 'admissionRules',
          'visibility', 'ownerId', 'ownerName', 'accentTone', 'avatarUrl', 'minAge', 'memberCount',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.salonId)
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 80
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 360
        && data.promptQuestion is string && data.promptQuestion.size() <= 240
        && data.admissionRules is string && data.admissionRules.size() <= 500
        && data.visibility in ['public', 'private']
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 60
        && data.accentTone in ['ink', 'ochre', 'terracotta', 'sage', 'sand']
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 60000))
        && (!('minAge' in data) || (data.minAge is int && data.minAge in [0, 13, 16, 18]))
        && data.memberCount is int && data.memberCount >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalonThread(data) {
      return data.keys().hasAll([
          'threadId', 'salonScope', 'salonId', 'authorId', 'authorName',
          'title', 'body', 'replyCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'threadId', 'salonScope', 'salonId', 'authorId', 'authorName',
          'title', 'body', 'minAge', 'isMature', 'matureReason',
          'replyCount', 'lastReplyId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.threadId)
        && data.salonScope in ['predefined', 'custom']
        && isValidId(data.salonId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60
        && data.title is string && data.title.size() >= 4 && data.title.size() <= 140
        && data.body is string && data.body.size() <= 1500
        && (!('minAge' in data) || (data.minAge is int && data.minAge in [0, 13, 16, 18]))
        && (!('isMature' in data) || data.isMature is bool)
        && (!('matureReason' in data) || (data.matureReason is string && data.matureReason.size() <= 180))
        && data.replyCount is int && data.replyCount >= 0
        && (!('lastReplyId' in data) || isValidId(data.lastReplyId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalonThreadReply(data) {
      return data.keys().hasAll([
          'replyId', 'threadId', 'salonId', 'authorId', 'authorName', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'replyId', 'threadId', 'salonId', 'authorId', 'authorName', 'content', 'createdAt'
        ])
        && isValidId(data.replyId)
        && isValidId(data.threadId)
        && isValidId(data.salonId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60
        && data.content is string && data.content.size() >= 2 && data.content.size() <= 1200
        && data.createdAt is timestamp;
    }

    function isValidSalonMember(data) {
      return data.keys().hasAll([
          'userId', 'salonId', 'salonOwnerId', 'userName', 'requestNote',
          'status', 'role', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'salonId', 'salonOwnerId', 'userName', 'requestNote',
          'status', 'role', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && isValidId(data.salonId)
        && isValidId(data.salonOwnerId)
        && data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 60
        && data.requestNote is string && data.requestNote.size() <= 300
        && data.status in ['pending', 'approved', 'rejected']
        && data.role in ['owner', 'member']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomSalonMessage(data) {
      return data.keys().hasAll([
          'messageId', 'salonId', 'senderId', 'senderName', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'messageId', 'salonId', 'senderId', 'senderName', 'content', 'createdAt'
        ])
        && isValidId(data.messageId)
        && isValidId(data.salonId)
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 60
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidExchange(data) {
      return data.keys().hasAll([
          'exchangeId', 'storyId', 'storyTitle', 'initiatorId', 'initiatorName',
          'recipientId', 'recipientName', 'participantIds', 'status',
          'lastMessagePreview', 'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'exchangeId', 'kind', 'storyId', 'storyTitle', 'initiatorId', 'initiatorName',
          'recipientId', 'recipientName', 'participantIds', 'hiddenFor', 'status',
          'lastMessagePreview', 'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.exchangeId)
        && (!('kind' in data) || data.kind in ['story', 'direct'])
        && isValidId(data.storyId)
        && data.storyTitle is string && data.storyTitle.size() >= 1 && data.storyTitle.size() <= 140
        && isValidId(data.initiatorId)
        && data.initiatorName is string && data.initiatorName.size() >= 2 && data.initiatorName.size() <= 60
        && isValidId(data.recipientId)
        && data.recipientName is string && data.recipientName.size() >= 2 && data.recipientName.size() <= 60
        && data.initiatorId != data.recipientId
        && data.participantIds is list
        && data.participantIds.size() == 2
        && isValidId(data.participantIds[0])
        && isValidId(data.participantIds[1])
        && data.participantIds[0] != data.participantIds[1]
        && (!('hiddenFor' in data) || (
          data.hiddenFor is list
          && data.hiddenFor.size() <= 2
          && (data.hiddenFor.size() < 1 || (isValidId(data.hiddenFor[0]) && data.hiddenFor[0] in data.participantIds))
          && (data.hiddenFor.size() < 2 || (isValidId(data.hiddenFor[1]) && data.hiddenFor[1] in data.participantIds))
        ))
        && data.status in ['active', 'archived']
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 160
        && isValidId(data.lastSenderId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
          'messageId', 'exchangeId', 'senderId', 'senderName',
          'participantIds', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'messageId', 'exchangeId', 'senderId', 'senderName',
          'participantIds', 'hiddenFor', 'content', 'createdAt'
        ])
        && isValidId(data.messageId)
        && isValidId(data.exchangeId)
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 60
        && data.participantIds is list
        && data.participantIds.size() == 2
        && isValidId(data.participantIds[0])
        && isValidId(data.participantIds[1])
        && (!('hiddenFor' in data) || (
          data.hiddenFor is list
          && data.hiddenFor.size() <= 2
          && (data.hiddenFor.size() < 1 || (isValidId(data.hiddenFor[0]) && data.hiddenFor[0] in data.participantIds))
          && (data.hiddenFor.size() < 2 || (isValidId(data.hiddenFor[1]) && data.hiddenFor[1] in data.participantIds))
        ))
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidUserRelationship(data) {
      return data.keys().hasAll([
          'ownerId', 'targetUserId', 'targetName', 'relation',
          'reason', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'targetUserId', 'targetName', 'relation',
          'reason', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.targetUserId)
        && data.ownerId != data.targetUserId
        && data.targetName is string && data.targetName.size() >= 2 && data.targetName.size() <= 60
        && data.relation in ['blocked', 'not_interested']
        && data.reason is string && data.reason.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoriteAuthor(data) {
      return data.keys().hasAll(['ownerId', 'authorId', 'authorName', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'authorId', 'authorName', 'createdAt'])
        && isValidId(data.ownerId)
        && isValidId(data.authorId)
        && data.ownerId != data.authorId
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidModerationAiAnalysis(ai) {
      return ai is map
        && ai.keys().hasAll([
          'analyzedAtIso', 'model', 'verdict', 'confidencePercent',
          'recommendedAction', 'suggestedGravity', 'suggestedCriteria',
          'summary', 'suggestedDecisionReason', 'needsAdminIntervention',
          'interventionReason'
        ])
        && ai.keys().hasOnly([
          'analyzedAtIso', 'model', 'verdict', 'confidencePercent',
          'recommendedAction', 'suggestedGravity', 'suggestedCriteria',
          'summary', 'suggestedDecisionReason', 'needsAdminIntervention',
          'interventionReason'
        ])
        && ai.analyzedAtIso is string && ai.analyzedAtIso.size() <= 40
        && ai.model is string && ai.model.size() <= 60
        && ai.verdict in ['outrage_confirme', 'incertain_a_verifier', 'aucun_outrage']
        && ai.confidencePercent is int && ai.confidencePercent >= 0 && ai.confidencePercent <= 100
        && ai.recommendedAction in ['avertir', 'examen_manuel', 'classer']
        && ai.suggestedGravity in ['aucune', 'moderee', 'grave', 'critique']
        && ai.suggestedCriteria is list && ai.suggestedCriteria.size() <= 6
        && (ai.suggestedCriteria.size() < 1 || (ai.suggestedCriteria[0] is string && ai.suggestedCriteria[0].size() <= 80))
        && (ai.suggestedCriteria.size() < 2 || (ai.suggestedCriteria[1] is string && ai.suggestedCriteria[1].size() <= 80))
        && (ai.suggestedCriteria.size() < 3 || (ai.suggestedCriteria[2] is string && ai.suggestedCriteria[2].size() <= 80))
        && (ai.suggestedCriteria.size() < 4 || (ai.suggestedCriteria[3] is string && ai.suggestedCriteria[3].size() <= 80))
        && (ai.suggestedCriteria.size() < 5 || (ai.suggestedCriteria[4] is string && ai.suggestedCriteria[4].size() <= 80))
        && (ai.suggestedCriteria.size() < 6 || (ai.suggestedCriteria[5] is string && ai.suggestedCriteria[5].size() <= 80))
        && ai.summary is string && ai.summary.size() <= 1000
        && ai.suggestedDecisionReason is string && ai.suggestedDecisionReason.size() <= 800
        && ai.needsAdminIntervention is bool
        && ai.interventionReason is string && ai.interventionReason.size() <= 400;
    }

    function isValidModerationCase(data) {
      return data.keys().hasAll([
          'caseId', 'reporterId', 'reporterName', 'targetUserId', 'targetUserName',
          'targetType', 'targetId', 'targetContextId', 'targetExcerpt',
          'category', 'description', 'status', 'reviewStep',
          'evaluationCriteria', 'gravityLevel', 'caseNotes', 'decisionReason',
          'warningIssued', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'caseId', 'reporterId', 'reporterName', 'targetUserId', 'targetUserName',
          'targetType', 'targetId', 'targetContextId', 'targetExcerpt',
          'category', 'description', 'status', 'reviewStep',
          'evaluationCriteria', 'gravityLevel', 'caseNotes', 'decisionReason',
          'warningIssued', 'warningId', 'reviewerId', 'reviewerName', 'reviewedAt',
          'aiAnalysis', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.caseId)
        && isValidId(data.reporterId)
        && data.reporterName is string && data.reporterName.size() >= 2 && data.reporterName.size() <= 60
        && isValidId(data.targetUserId)
        && data.reporterId != data.targetUserId
        && data.targetUserName is string && data.targetUserName.size() >= 2 && data.targetUserName.size() <= 60
        && data.targetType in [
          'private_message', 'story', 'echo', 'salon_message',
          'salon_thread', 'thread_reply', 'profile'
        ]
        && isValidId(data.targetId)
        && isValidId(data.targetContextId)
        && data.targetExcerpt is string && data.targetExcerpt.size() <= 1000
        && data.category in [
          'propos-outrageants', 'harcelement', 'haine-discrimination',
          'contenu-inapproprie', 'usurpation-spam', 'plagiat', 'autre'
        ]
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 800
        && data.status in ['open', 'under_review', 'resolved_warned', 'resolved_dismissed']
        && data.reviewStep in ['recu', 'analyse_faits', 'evaluation_gravite', 'decision_prise']
        && data.evaluationCriteria is list
        && data.evaluationCriteria.size() <= 6
        && (data.evaluationCriteria.size() < 1 || (data.evaluationCriteria[0] is string && data.evaluationCriteria[0].size() <= 80))
        && (data.evaluationCriteria.size() < 2 || (data.evaluationCriteria[1] is string && data.evaluationCriteria[1].size() <= 80))
        && (data.evaluationCriteria.size() < 3 || (data.evaluationCriteria[2] is string && data.evaluationCriteria[2].size() <= 80))
        && (data.evaluationCriteria.size() < 4 || (data.evaluationCriteria[3] is string && data.evaluationCriteria[3].size() <= 80))
        && (data.evaluationCriteria.size() < 5 || (data.evaluationCriteria[4] is string && data.evaluationCriteria[4].size() <= 80))
        && (data.evaluationCriteria.size() < 6 || (data.evaluationCriteria[5] is string && data.evaluationCriteria[5].size() <= 80))
        && data.gravityLevel in ['aucune', 'moderee', 'grave', 'critique']
        && data.caseNotes is string && data.caseNotes.size() <= 1000
        && data.decisionReason is string && data.decisionReason.size() <= 800
        && data.warningIssued is bool
        && (!('warningId' in data) || isValidId(data.warningId))
        && (!('reviewerId' in data) || isValidId(data.reviewerId))
        && (!('reviewerName' in data) || (data.reviewerName is string && data.reviewerName.size() >= 2 && data.reviewerName.size() <= 60))
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && (!('aiAnalysis' in data) || isValidModerationAiAnalysis(data.aiAnalysis))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberWarning(data) {
      return data.keys().hasAll([
          'warningId', 'caseId', 'targetUserId', 'targetUserName',
          'category', 'severity', 'justification', 'excerptSnapshot',
          'issuedById', 'issuedByName', 'acknowledged', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'warningId', 'caseId', 'targetUserId', 'targetUserName',
          'category', 'severity', 'justification', 'excerptSnapshot',
          'issuedById', 'issuedByName', 'acknowledged', 'acknowledgedAt',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.warningId)
        && isValidId(data.caseId)
        && isValidId(data.targetUserId)
        && data.targetUserName is string && data.targetUserName.size() >= 2 && data.targetUserName.size() <= 60
        && data.category in [
          'propos-outrageants', 'harcelement', 'haine-discrimination',
          'contenu-inapproprie', 'usurpation-spam', 'plagiat', 'autre'
        ]
        && data.severity in ['moderee', 'grave', 'critique']
        && data.justification is string && data.justification.size() >= 10 && data.justification.size() <= 800
        && data.excerptSnapshot is string && data.excerptSnapshot.size() <= 1000
        && isValidId(data.issuedById)
        && data.issuedByName is string && data.issuedByName.size() >= 2 && data.issuedByName.size() <= 60
        && data.acknowledged is bool
        && (!('acknowledgedAt' in data) || data.acknowledgedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Public author cards (no PII)
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn()
        && (resource.data.discoverable == true || resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'bio', 'listeningNote',
          'favoriteTrackTitle', 'favoriteTrackArtist', 'favoriteTrackUrl',
          'favoriteNovel', 'interests', 'avatarUrl', 'discoverable', 'updatedAt'
        ]);
      allow delete: if false;

      // Yope-style profile wall cards
      match /wallItems/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId);
        allow list: if resource.data.visibility == 'public';
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidWallItem(incoming())
          && incoming().itemId == itemId
          && incoming().ownerId == request.auth.uid
          && incoming().visibility == 'public'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(userId));
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidWallItem(incoming())
          && incoming().itemId == existing().itemId
          && incoming().ownerId == existing().ownerId
          && incoming().visibility == existing().visibility
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerName', 'kind', 'title', 'subtitle', 'body', 'mediaUrl', 'accentTone', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }

      // Reposted / reshared stories on a user's profile / wall
      match /reposts/{storyId} {
        allow get: if isValidId(userId)
          && isValidId(storyId)
          && (existing().visibility == 'public' || isOwner(userId));
        allow list: if resource.data.visibility == 'public'
          || (isSignedIn() && resource.data.reposterId == request.auth.uid);
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && isValidRepost(incoming())
          && incoming().repostId == storyId
          && incoming().reposterId == request.auth.uid
          && incoming().storyId == storyId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(userId))
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && canReadStoryData(get(/databases/$(database)/documents/stories/$(storyId)).data)
          && (
            incoming().visibility == 'private'
            || (
              get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
              && (
                !('customSalonVisibility' in get(/databases/$(database)/documents/stories/$(storyId)).data)
                || get(/databases/$(database)/documents/stories/$(storyId)).data.customSalonVisibility != 'private'
              )
            )
          );
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && isValidRepost(incoming())
          && incoming().repostId == existing().repostId
          && incoming().reposterId == existing().reposterId
          && incoming().storyId == existing().storyId
          && incoming().storyTitle == existing().storyTitle
          && incoming().storyExcerpt == existing().storyExcerpt
          && incoming().storyAuthorId == existing().storyAuthorId
          && incoming().storyAuthorName == existing().storyAuthorName
          && incoming().storyTheme == existing().storyTheme
          && incoming().readingMinutes == existing().readingMinutes
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'reposterName', 'note', 'visibility', 'updatedAt'
          ])
          && (
            incoming().visibility == 'private'
            || (
              exists(/databases/$(database)/documents/stories/$(storyId))
              && get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
              && (
                !('customSalonVisibility' in get(/databases/$(database)/documents/stories/$(storyId)).data)
                || get(/databases/$(database)/documents/stories/$(storyId)).data.customSalonVisibility != 'private'
              )
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && existing().reposterId == request.auth.uid;
      }
    }

    // Private PII user info & private age setting
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && docId == 'info' && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidPrivateInfo(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidPrivateInfo(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'declaredAge', 'birthYear', 'ageUpdatedAt', 'favoriteThemes', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Private saved-for-later story bookmarks
    match /users/{userId}/bookmarks/{storyId} {
      allow get: if isValidId(userId) && isValidId(storyId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(storyId)
        && isOwner(userId)
        && isValidBookmark(incoming())
        && incoming().userId == request.auth.uid
        && incoming().storyId == storyId
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/stories/$(storyId))
        && canReadStoryData(get(/databases/$(database)/documents/stories/$(storyId)).data);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(storyId)
        && isOwner(userId)
        && existing().userId == request.auth.uid;
    }

    // Private favorite highlighted quotes ("Citations favorites")
    match /users/{userId}/quotes/{quoteId} {
      allow get: if isValidId(userId) && isValidId(quoteId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(quoteId)
        && isOwner(userId)
        && isValidQuote(incoming())
        && incoming().quoteId == quoteId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/stories/$(incoming().storyId))
        && canReadStoryData(get(/databases/$(database)/documents/stories/$(incoming().storyId)).data);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(quoteId)
        && isOwner(userId)
        && existing().userId == request.auth.uid;
    }

    // Per-user block and not-interested member preferences
    match /users/{userId}/relationships/{targetUserId} {
      allow get: if isValidId(userId) && isValidId(targetUserId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(targetUserId)
        && isOwner(userId)
        && userId != targetUserId
        && isValidUserRelationship(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().targetUserId == targetUserId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(targetUserId));
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(targetUserId)
        && isOwner(userId)
        && isValidUserRelationship(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().targetUserId == existing().targetUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'targetName', 'relation', 'reason', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(targetUserId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
    }

    // Per-user favorite authors for the personalized "Pour vous" feed
    match /users/{userId}/favoriteAuthors/{authorId} {
      allow get: if isValidId(userId) && isValidId(authorId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(authorId)
        && isOwner(userId)
        && userId != authorId
        && isValidFavoriteAuthor(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().authorId == authorId
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(authorId));
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(authorId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
    }

    // Personal stories & serialized novels
    match /stories/{storyId} {
      allow get: if isValidId(storyId)
        && (
          existing().visibility == 'public'
          || (isSignedIn() && existing().authorId == request.auth.uid)
          || (
            isSignedIn()
            && 'customSalonId' in existing()
            && existing().customSalonVisibility == 'private'
            && isApprovedCustomSalonMember(existing().customSalonId)
          )
        );
      allow list: if resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || (
          isSignedIn()
          && 'customSalonId' in resource.data
          && resource.data.customSalonVisibility == 'private'
          && isApprovedCustomSalonMember(resource.data.customSalonId)
        );

      allow create: if isVerifiedUser()
        && isValidId(storyId)
        && isValidStory(incoming())
        && meetsStoryFormatMinLength(incoming())
        && incoming().charterAttested == true
        && incoming().storyId == storyId
        && incoming().authorId == request.auth.uid
        && incoming().resonanceCount == 0
        && incoming().echoCount == 0
        && (!('viewCount' in incoming()) || incoming().viewCount == 0)
        && !('lastEchoId' in incoming())
        && !('lastChapterId' in incoming())
        && !('lastViewId' in incoming())
        && (!('chapterCount' in incoming()) || incoming().chapterCount <= 1)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          !('customSalonId' in incoming())
          || (
            'customSalonName' in incoming()
            && 'customSalonVisibility' in incoming()
            && exists(/databases/$(database)/documents/customSalons/$(incoming().customSalonId))
            && incoming().customSalonName == get(/databases/$(database)/documents/customSalons/$(incoming().customSalonId)).data.name
            && incoming().customSalonVisibility == get(/databases/$(database)/documents/customSalons/$(incoming().customSalonId)).data.visibility
            && (
              (incoming().customSalonVisibility == 'public')
              || (
                incoming().customSalonVisibility == 'private'
                && incoming().visibility == 'private'
                && (
                  get(/databases/$(database)/documents/customSalons/$(incoming().customSalonId)).data.ownerId == request.auth.uid
                  || isApprovedCustomSalonMember(incoming().customSalonId)
                )
              )
            )
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(storyId)
        && isValidStory(incoming())
        && incoming().storyId == existing().storyId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action A: Author edits story content, format, age metadata, cadence, or visibility
          (
            existing().authorId == request.auth.uid
            && incoming().resonanceCount == existing().resonanceCount
            && incoming().echoCount == existing().echoCount
            && (
              (!('content' in incoming().diff(existing()).affectedKeys()) && !('storyFormat' in incoming().diff(existing()).affectedKeys()))
              || meetsStoryFormatMinLength(incoming())
            )
            && ((!('customSalonId' in existing()) && !('customSalonId' in incoming()))
              || ('customSalonId' in existing() && 'customSalonId' in incoming() && incoming().customSalonId == existing().customSalonId))
            && ((!('customSalonName' in existing()) && !('customSalonName' in incoming()))
              || ('customSalonName' in existing() && 'customSalonName' in incoming() && incoming().customSalonName == existing().customSalonName))
            && ((!('customSalonVisibility' in existing()) && !('customSalonVisibility' in incoming()))
              || ('customSalonVisibility' in existing() && 'customSalonVisibility' in incoming() && incoming().customSalonVisibility == existing().customSalonVisibility))
            && (!('customSalonVisibility' in existing()) || existing().customSalonVisibility != 'private' || incoming().visibility == 'private')
            && ((!('viewCount' in existing()) && !('viewCount' in incoming()))
              || ('viewCount' in existing() && 'viewCount' in incoming() && incoming().viewCount == existing().viewCount))
            && ((!('lastViewId' in existing()) && !('lastViewId' in incoming()))
              || ('lastViewId' in existing() && 'lastViewId' in incoming() && incoming().lastViewId == existing().lastViewId))
            && ((!('lastEchoId' in existing()) && !('lastEchoId' in incoming()))
              || ('lastEchoId' in existing() && 'lastEchoId' in incoming() && incoming().lastEchoId == existing().lastEchoId))
            && ((!('lastChapterId' in existing()) && !('lastChapterId' in incoming()))
              || ('lastChapterId' in existing() && 'lastChapterId' in incoming() && incoming().lastChapterId == existing().lastChapterId))
            && ((!('chapterCount' in existing()) && !('chapterCount' in incoming()))
              || ('chapterCount' in existing() && 'chapterCount' in incoming() && incoming().chapterCount == existing().chapterCount))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'title', 'excerpt', 'content', 'theme', 'storyScope',
              'storyFormat', 'novelGenre', 'coverUrl', 'plagiarismAttested',
              'releaseCadence', 'seriesStatus', 'minAge', 'isMature', 'matureReason',
              'charterAttested', 'promptQuestion', 'visibility', 'isAnonymous', 'readingMinutes', 'updatedAt'
            ])
          )
          ||
          // Action B: Atomic resonance toggle on a public story
          (
            existing().visibility == 'public'
            && incoming().diff(existing()).affectedKeys().hasOnly(['resonanceCount', 'updatedAt'])
            && (
              (
                incoming().resonanceCount == existing().resonanceCount + 1
                && !exists(/databases/$(database)/documents/stories/$(storyId)/resonances/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/stories/$(storyId)/resonances/$(request.auth.uid))
              )
              ||
              (
                incoming().resonanceCount == existing().resonanceCount - 1
                && exists(/databases/$(database)/documents/stories/$(storyId)/resonances/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/stories/$(storyId)/resonances/$(request.auth.uid))
              )
            )
          )
          ||
          // Action C: Atomic echo/comment increment on a public story
          (
            existing().visibility == 'public'
            && 'lastEchoId' in incoming()
            && incoming().diff(existing()).affectedKeys().hasOnly(['echoCount', 'lastEchoId', 'updatedAt'])
            && incoming().echoCount == existing().echoCount + 1
            && !exists(/databases/$(database)/documents/stories/$(storyId)/echoes/$(incoming().lastEchoId))
            && existsAfter(/databases/$(database)/documents/stories/$(storyId)/echoes/$(incoming().lastEchoId))
          )
          ||
          // Action D: Author atomically publishes a new chapter in serialized novel
          (
            existing().authorId == request.auth.uid
            && 'lastChapterId' in incoming()
            && 'chapterCount' in incoming()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'chapterCount', 'lastChapterId', 'seriesStatus', 'updatedAt'
            ])
            && (
              ('chapterCount' in existing() && incoming().chapterCount == existing().chapterCount + 1)
              || (!('chapterCount' in existing()) && incoming().chapterCount == 2)
            )
            && !exists(/databases/$(database)/documents/stories/$(storyId)/chapters/$(incoming().lastChapterId))
            && existsAfter(/databases/$(database)/documents/stories/$(storyId)/chapters/$(incoming().lastChapterId))
          )
          ||
          // Action E: Atomic view increment on a public story
          (
            existing().visibility == 'public'
            && 'lastViewId' in incoming()
            && incoming().diff(existing()).affectedKeys().hasOnly(['viewCount', 'lastViewId', 'updatedAt'])
            && (
              ('viewCount' in existing() && incoming().viewCount == existing().viewCount + 1)
              || (!('viewCount' in existing()) && incoming().viewCount == 1)
            )
            && !exists(/databases/$(database)/documents/stories/$(storyId)/views/$(incoming().lastViewId))
            && existsAfter(/databases/$(database)/documents/stories/$(storyId)/views/$(incoming().lastViewId))
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(storyId)
        && existing().authorId == request.auth.uid;

      // Story chapters subcollection
      match /chapters/{chapterId} {
        allow get: if isValidId(storyId)
          && isValidId(chapterId)
          && (
            get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
            || (isSignedIn() && existing().authorId == request.auth.uid)
            || (
              isSignedIn()
              && 'customSalonId' in get(/databases/$(database)/documents/stories/$(storyId)).data
              && get(/databases/$(database)/documents/stories/$(storyId)).data.customSalonVisibility == 'private'
              && isApprovedCustomSalonMember(get(/databases/$(database)/documents/stories/$(storyId)).data.customSalonId)
            )
          );
        allow list: if resource.data.storyVisibility == 'public'
          || (isSignedIn() && resource.data.authorId == request.auth.uid)
          || (
            isSignedIn()
            && 'customSalonId' in get(/databases/$(database)/documents/stories/$(storyId)).data
            && get(/databases/$(database)/documents/stories/$(storyId)).data.customSalonVisibility == 'private'
            && isApprovedCustomSalonMember(get(/databases/$(database)/documents/stories/$(storyId)).data.customSalonId)
          );
        allow create: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(chapterId)
          && isValidChapter(incoming())
          && incoming().content.size() >= 3000
          && incoming().chapterId == chapterId
          && incoming().storyId == storyId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
          && incoming().storyVisibility == get(/databases/$(database)/documents/stories/$(storyId)).data.visibility
          && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.lastChapterId == chapterId;
        allow update: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(chapterId)
          && isValidChapter(incoming())
          && (!('content' in incoming().diff(existing()).affectedKeys()) || incoming().content.size() >= 3000)
          && existing().authorId == request.auth.uid
          && incoming().chapterId == existing().chapterId
          && incoming().storyId == existing().storyId
          && incoming().authorId == existing().authorId
          && incoming().chapterNumber == existing().chapterNumber
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'content', 'authorNote', 'readingMinutes', 'storyVisibility', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(chapterId)
          && existing().authorId == request.auth.uid;
      }

      // Story resonances subcollection
      match /resonances/{userId} {
        allow get: if isValidId(storyId)
          && isValidId(userId)
          && (
            get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
            || isOwner(userId)
          );
        allow list: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidResonance(incoming())
          && incoming().userId == request.auth.uid
          && incoming().storyId == storyId
          && 'authorId' in incoming()
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
          && incoming().authorId == get(/databases/$(database)/documents/stories/$(storyId)).data.authorId
          && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.resonanceCount
             == get(/databases/$(database)/documents/stories/$(storyId)).data.resonanceCount + 1;
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(userId)
          && isOwner(userId)
          && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.resonanceCount
             == get(/databases/$(database)/documents/stories/$(storyId)).data.resonanceCount - 1;
      }

      // Story views subcollection (for daily reading statistics)
      match /views/{viewId} {
        allow get: if isSignedIn()
          && isValidId(storyId)
          && isValidId(viewId)
          && (existing().viewerId == request.auth.uid || existing().authorId == request.auth.uid);
        allow list: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(viewId)
          && isValidStoryView(incoming())
          && incoming().viewId == viewId
          && incoming().storyId == storyId
          && incoming().viewerId == request.auth.uid
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
          && incoming().authorId == get(/databases/$(database)/documents/stories/$(storyId)).data.authorId
          && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.lastViewId == viewId;
        allow update: if false;
        allow delete: if false;
      }

      // Story comments & echoes subcollection
      match /echoes/{echoId} {
        allow get: if isValidId(storyId)
          && isValidId(echoId)
          && (
            get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
            || (isSignedIn() && existing().authorId == request.auth.uid)
          );
        allow list: if resource.data.storyVisibility == 'public'
          || (isSignedIn() && resource.data.authorId == request.auth.uid);
        allow create: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(echoId)
          && isValidEcho(incoming())
          && incoming().echoId == echoId
          && incoming().storyId == storyId
          && incoming().authorId == request.auth.uid
          && incoming().storyVisibility == 'public'
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
          && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.lastEchoId == echoId;
        allow update: if false;
        allow delete: if false;
      }

      // Reader anti-plagiarism reports for public serialized novels
      match /plagiarismReports/{userId} {
        allow get: if isSignedIn()
          && isValidId(storyId)
          && isValidId(userId)
          && (
            isOwner(userId)
            || get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
          );
        allow list: if isSignedIn()
          && resource.data.reporterId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidPlagiarismReport(incoming())
          && incoming().storyId == storyId
          && incoming().reporterId == request.auth.uid
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.visibility == 'public'
          && get(/databases/$(database)/documents/stories/$(storyId)).data.storyFormat == 'roman';
        allow update: if false;
        allow delete: if false;
      }
    }

    // Built-in Salon text-only public chat rooms
    match /salons/{salonId}/messages/{messageId} {
      allow get: if isSignedIn()
        && isValidSalonId(salonId)
        && isValidId(messageId);
      allow list: if isSignedIn()
        && isValidSalonId(salonId)
        && resource.data.salonId == salonId;
      allow create: if isVerifiedUser()
        && isValidSalonId(salonId)
        && isValidId(messageId)
        && isValidSalonMessage(incoming())
        && incoming().messageId == messageId
        && incoming().salonId == salonId
        && incoming().senderId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidSalonId(salonId)
        && isValidId(messageId)
        && existing().senderId == request.auth.uid;
    }

    // Built-in Salon discussion threads & replies
    match /salons/{salonId}/threads/{threadId} {
      allow get: if isValidSalonId(salonId)
        && isValidId(threadId);
      allow list: if isValidSalonId(salonId)
        && resource.data.salonScope == 'predefined'
        && resource.data.salonId == salonId;
      allow create: if isVerifiedUser()
        && isValidSalonId(salonId)
        && isValidId(threadId)
        && isValidSalonThread(incoming())
        && incoming().threadId == threadId
        && incoming().salonScope == 'predefined'
        && incoming().salonId == salonId
        && incoming().authorId == request.auth.uid
        && incoming().replyCount == 0
        && !('lastReplyId' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidSalonId(salonId)
        && isValidId(threadId)
        && isValidSalonThread(incoming())
        && incoming().threadId == existing().threadId
        && incoming().salonScope == existing().salonScope
        && incoming().salonId == existing().salonId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().authorId == request.auth.uid
            && incoming().replyCount == existing().replyCount
            && ((!('lastReplyId' in existing()) && !('lastReplyId' in incoming()))
              || ('lastReplyId' in existing() && 'lastReplyId' in incoming() && incoming().lastReplyId == existing().lastReplyId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'minAge', 'isMature', 'matureReason', 'updatedAt'
            ])
          )
          ||
          (
            'lastReplyId' in incoming()
            && incoming().diff(existing()).affectedKeys().hasOnly(['replyCount', 'lastReplyId', 'updatedAt'])
            && incoming().replyCount == existing().replyCount + 1
            && !exists(/databases/$(database)/documents/salons/$(salonId)/threads/$(threadId)/replies/$(incoming().lastReplyId))
            && existsAfter(/databases/$(database)/documents/salons/$(salonId)/threads/$(threadId)/replies/$(incoming().lastReplyId))
          )
        );
      allow delete: if isVerifiedUser()
        && isValidSalonId(salonId)
        && isValidId(threadId)
        && existing().authorId == request.auth.uid;

      match /replies/{replyId} {
        allow get: if isValidSalonId(salonId)
          && isValidId(threadId)
          && isValidId(replyId);
        allow list: if isValidSalonId(salonId)
          && isValidId(threadId)
          && resource.data.salonId == salonId
          && resource.data.threadId == threadId;
        allow create: if isVerifiedUser()
          && isValidSalonId(salonId)
          && isValidId(threadId)
          && isValidId(replyId)
          && isValidSalonThreadReply(incoming())
          && incoming().replyId == replyId
          && incoming().threadId == threadId
          && incoming().salonId == salonId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && getAfter(/databases/$(database)/documents/salons/$(salonId)/threads/$(threadId)).data.lastReplyId == replyId;
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidSalonId(salonId)
          && isValidId(threadId)
          && isValidId(replyId)
          && existing().authorId == request.auth.uid;
      }
    }

    // User-created community salons with custom admission rules & profile avatars
    match /customSalons/{salonId} {
      allow get: if isValidId(salonId);
      allow list: if resource.data.visibility in ['public', 'private'];

      allow create: if isVerifiedUser()
        && isValidId(salonId)
        && isValidCustomSalon(incoming())
        && incoming().salonId == salonId
        && incoming().ownerId == request.auth.uid
        && incoming().memberCount == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/customSalons/$(salonId)/members/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(salonId)
        && isValidCustomSalon(incoming())
        && incoming().salonId == existing().salonId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action A: Owner edits salon info, avatar, age setting, admission rules, or visibility
          (
            existing().ownerId == request.auth.uid
            && incoming().memberCount == existing().memberCount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'description', 'promptQuestion', 'admissionRules',
              'visibility', 'ownerName', 'accentTone', 'avatarUrl', 'minAge', 'updatedAt'
            ])
          )
          ||
          // Action B: Atomic memberCount update when joining, leaving, or owner approving/removing
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
            && (
              existing().ownerId == request.auth.uid
              || (
                existing().visibility == 'public'
                && incoming().memberCount == existing().memberCount + 1
                && !exists(/databases/$(database)/documents/customSalons/$(salonId)/members/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/customSalons/$(salonId)/members/$(request.auth.uid))
              )
              || (
                incoming().memberCount == existing().memberCount - 1
                && exists(/databases/$(database)/documents/customSalons/$(salonId)/members/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/customSalons/$(salonId)/members/$(request.auth.uid))
              )
            )
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(salonId)
        && existing().ownerId == request.auth.uid;

      // Membership & admission requests subcollection
      match /members/{userId} {
        allow get: if isSignedIn()
          && isValidId(salonId)
          && isValidId(userId)
          && (
            isOwner(userId)
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            || (
              get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
              && existing().status == 'approved'
            )
          );
        allow list: if isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.salonOwnerId == request.auth.uid
          );

        allow create: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidSalonMember(incoming())
          && incoming().userId == request.auth.uid
          && incoming().salonId == salonId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            // Case 1: Creator initializes owner membership atomically with salon creation
            (
              incoming().role == 'owner'
              && incoming().status == 'approved'
              && incoming().salonOwnerId == request.auth.uid
              && getAfter(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            )
            ||
            // Case 2: Member joins a public salon (instant approved) or requests admission to a private salon (pending)
            (
              incoming().role == 'member'
              && incoming().salonOwnerId == get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId
              && (
                (
                  get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
                  && incoming().status == 'approved'
                  && getAfter(/databases/$(database)/documents/customSalons/$(salonId)).data.memberCount
                     == get(/databases/$(database)/documents/customSalons/$(salonId)).data.memberCount + 1
                )
                ||
                (
                  get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'private'
                  && incoming().status == 'pending'
                )
              )
            )
          );

        allow update: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(userId)
          && isValidSalonMember(incoming())
          && incoming().userId == existing().userId
          && incoming().salonId == existing().salonId
          && incoming().salonOwnerId == existing().salonOwnerId
          && incoming().role == existing().role
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existing().role == 'member'
          && (
            // Owner approves or rejects admission request
            (
              get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              && incoming().status in ['approved', 'rejected']
            )
            ||
            // Applicant updates request note / retries admission
            (
              isOwner(userId)
              && existing().status != 'approved'
              && incoming().status == 'pending'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'requestNote', 'userName', 'updatedAt'])
            )
          );

        allow delete: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(userId)
          && existing().role != 'owner'
          && (
            isOwner(userId)
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
          );
      }

      // Discussion chat inside a custom salon
      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidId(salonId)
          && isValidId(messageId)
          && (
            get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            || isApprovedCustomSalonMember(salonId)
          );
        allow list: if isSignedIn()
          && resource.data.salonId == salonId
          && (
            get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            || isApprovedCustomSalonMember(salonId)
          );
        allow create: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(messageId)
          && isValidCustomSalonMessage(incoming())
          && incoming().messageId == messageId
          && incoming().salonId == salonId
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && (
            get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            || isApprovedCustomSalonMember(salonId)
          );
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(messageId)
          && (
            existing().senderId == request.auth.uid
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
          );
      }

      // Discussion threads & replies inside a custom community salon
      match /threads/{threadId} {
        allow get: if isValidId(salonId)
          && isValidId(threadId)
          && (
            get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
            || (isSignedIn() && get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid)
            || isApprovedCustomSalonMember(salonId)
          );
        allow list: if resource.data.salonScope == 'custom'
          && resource.data.salonId == salonId
          && (
            get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
            || (isSignedIn() && get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid)
            || isApprovedCustomSalonMember(salonId)
          );
        allow create: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(threadId)
          && isValidSalonThread(incoming())
          && incoming().threadId == threadId
          && incoming().salonScope == 'custom'
          && incoming().salonId == salonId
          && incoming().authorId == request.auth.uid
          && incoming().replyCount == 0
          && !('lastReplyId' in incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            || isApprovedCustomSalonMember(salonId)
          );
        allow update: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(threadId)
          && isValidSalonThread(incoming())
          && incoming().threadId == existing().threadId
          && incoming().salonScope == existing().salonScope
          && incoming().salonId == existing().salonId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            || isApprovedCustomSalonMember(salonId)
          )
          && (
            (
              existing().authorId == request.auth.uid
              && incoming().replyCount == existing().replyCount
              && ((!('lastReplyId' in existing()) && !('lastReplyId' in incoming()))
                || ('lastReplyId' in existing() && 'lastReplyId' in incoming() && incoming().lastReplyId == existing().lastReplyId))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'body', 'minAge', 'isMature', 'matureReason', 'updatedAt'
              ])
            )
            ||
            (
              'lastReplyId' in incoming()
              && incoming().diff(existing()).affectedKeys().hasOnly(['replyCount', 'lastReplyId', 'updatedAt'])
              && incoming().replyCount == existing().replyCount + 1
              && !exists(/databases/$(database)/documents/customSalons/$(salonId)/threads/$(threadId)/replies/$(incoming().lastReplyId))
              && existsAfter(/databases/$(database)/documents/customSalons/$(salonId)/threads/$(threadId)/replies/$(incoming().lastReplyId))
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(salonId)
          && isValidId(threadId)
          && (
            existing().authorId == request.auth.uid
            || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
          );

        match /replies/{replyId} {
          allow get: if isValidId(salonId)
            && isValidId(threadId)
            && isValidId(replyId)
            && (
              get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
              || (isSignedIn() && get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid)
              || isApprovedCustomSalonMember(salonId)
            );
          allow list: if isValidId(threadId)
            && resource.data.salonId == salonId
            && resource.data.threadId == threadId
            && (
              get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
              || (isSignedIn() && get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid)
              || isApprovedCustomSalonMember(salonId)
            );
          allow create: if isVerifiedUser()
            && isValidId(salonId)
            && isValidId(threadId)
            && isValidId(replyId)
            && isValidSalonThreadReply(incoming())
            && incoming().replyId == replyId
            && incoming().threadId == threadId
            && incoming().salonId == salonId
            && incoming().authorId == request.auth.uid
            && incoming().createdAt == request.time
            && (
              get(/databases/$(database)/documents/customSalons/$(salonId)).data.visibility == 'public'
              || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
              || isApprovedCustomSalonMember(salonId)
            )
            && getAfter(/databases/$(database)/documents/customSalons/$(salonId)/threads/$(threadId)).data.lastReplyId == replyId;
          allow update: if false;
          allow delete: if isVerifiedUser()
            && isValidId(salonId)
            && isValidId(threadId)
            && isValidId(replyId)
            && (
              existing().authorId == request.auth.uid
              || get(/databases/$(database)/documents/customSalons/$(salonId)).data.ownerId == request.auth.uid
            );
        }
      }
    }

    // 1-on-1 Private Exchanges (story-anchored OR direct member chat)
    match /exchanges/{exchangeId} {
      allow get: if isSignedIn()
        && isValidId(exchangeId)
        && (resource == null || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if isVerifiedUser()
        && isValidId(exchangeId)
        && isValidExchange(incoming())
        && incoming().exchangeId == exchangeId
        && incoming().initiatorId == request.auth.uid
        && incoming().recipientId != request.auth.uid
        && incoming().participantIds[0] == request.auth.uid
        && incoming().participantIds[1] == incoming().recipientId
        && incoming().lastSenderId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !isBlockedBetween(request.auth.uid, incoming().recipientId)
        && (
          (
            incoming().storyId == 'direct'
            && 'kind' in incoming()
            && incoming().kind == 'direct'
            && exists(/databases/$(database)/documents/publicProfiles/$(incoming().recipientId))
          )
          ||
          (
            exists(/databases/$(database)/documents/stories/$(incoming().storyId))
            && get(/databases/$(database)/documents/stories/$(incoming().storyId)).data.visibility == 'public'
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(exchangeId)
        && request.auth.uid in existing().participantIds
        && isValidExchange(incoming())
        && incoming().exchangeId == existing().exchangeId
        && incoming().storyId == existing().storyId
        && incoming().storyTitle == existing().storyTitle
        && incoming().initiatorId == existing().initiatorId
        && incoming().initiatorName == existing().initiatorName
        && incoming().recipientId == existing().recipientId
        && incoming().recipientName == existing().recipientName
        && incoming().participantIds == existing().participantIds
        && (
          (!('kind' in existing()) && !('kind' in incoming()))
          || ('kind' in existing() && 'kind' in incoming() && incoming().kind == existing().kind)
        )
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action A: Participant sends a new message
          (
            existing().status == 'active'
            && !isBlockedBetween(existing().initiatorId, existing().recipientId)
            && incoming().lastSenderId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'lastSenderId', 'hiddenFor', 'updatedAt'])
            && (!('hiddenFor' in incoming()) || incoming().hiddenFor.size() == 0)
          )
          ||
          // Action B: Participant archives or reopens exchange
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Action C: Participant hides/deletes conversation from their own view
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['hiddenFor', 'updatedAt'])
            && 'hiddenFor' in incoming()
            && request.auth.uid in incoming().hiddenFor
          )
          ||
          // Action D: Participant updates conversation preview after deleting own message
          (
            existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'lastSenderId', 'updatedAt'])
            && incoming().lastSenderId in existing().participantIds
          )
        );

      allow delete: if false;

      // Messages inside a private exchange
      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidId(exchangeId)
          && isValidId(messageId)
          && request.auth.uid in get(/databases/$(database)/documents/exchanges/$(exchangeId)).data.participantIds;
        allow list: if isSignedIn()
          && request.auth.uid in resource.data.participantIds;
        allow create: if isVerifiedUser()
          && isValidId(exchangeId)
          && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().messageId == messageId
          && incoming().exchangeId == exchangeId
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && (!('hiddenFor' in incoming()) || incoming().hiddenFor.size() == 0)
          && !isBlockedBetween(incoming().participantIds[0], incoming().participantIds[1])
          && getAfter(/databases/$(database)/documents/exchanges/$(exchangeId)).data.status == 'active'
          && request.auth.uid in getAfter(/databases/$(database)/documents/exchanges/$(exchangeId)).data.participantIds
          && incoming().participantIds == getAfter(/databases/$(database)/documents/exchanges/$(exchangeId)).data.participantIds;
        allow update: if isVerifiedUser()
          && isValidId(exchangeId)
          && isValidId(messageId)
          && request.auth.uid in existing().participantIds
          && isValidMessage(incoming())
          && incoming().messageId == existing().messageId
          && incoming().exchangeId == existing().exchangeId
          && incoming().senderId == existing().senderId
          && incoming().senderName == existing().senderName
          && incoming().participantIds == existing().participantIds
          && incoming().content == existing().content
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['hiddenFor'])
          && 'hiddenFor' in incoming()
          && request.auth.uid in incoming().hiddenFor;
        allow delete: if isVerifiedUser()
          && isValidId(exchangeId)
          && isValidId(messageId)
          && existing().senderId == request.auth.uid
          && request.auth.uid in existing().participantIds;
      }
    }

    // User-submitted moderation reports & structured case-study reviews
    match /moderationCases/{caseId} {
      allow get: if isSignedIn()
        && isValidId(caseId)
        && (existing().reporterId == request.auth.uid || isAdminEmail());
      allow list: if isSignedIn()
        && (resource.data.reporterId == request.auth.uid || isAdminEmail());

      allow create: if isVerifiedUser()
        && isValidId(caseId)
        && isValidModerationCase(incoming())
        && incoming().caseId == caseId
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open'
        && incoming().reviewStep == 'recu'
        && incoming().evaluationCriteria.size() == 0
        && incoming().gravityLevel == 'aucune'
        && incoming().caseNotes == ''
        && incoming().decisionReason == ''
        && incoming().warningIssued == false
        && !('warningId' in incoming())
        && !('reviewerId' in incoming())
        && !('reviewerName' in incoming())
        && !('reviewedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdminEmail()
        && isValidId(caseId)
        && isValidModerationCase(incoming())
        && incoming().caseId == existing().caseId
        && incoming().reporterId == existing().reporterId
        && incoming().reporterName == existing().reporterName
        && incoming().targetUserId == existing().targetUserId
        && incoming().targetUserName == existing().targetUserName
        && incoming().targetType == existing().targetType
        && incoming().targetId == existing().targetId
        && incoming().targetContextId == existing().targetContextId
        && incoming().targetExcerpt == existing().targetExcerpt
        && incoming().category == existing().category
        && incoming().description == existing().description
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status in ['open', 'under_review']
        && (
          // Action A: Advance structured case-study analysis & notes
          (
            incoming().status == 'under_review'
            && incoming().warningIssued == false
            && !('warningId' in incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reviewStep', 'evaluationCriteria', 'gravityLevel',
              'caseNotes', 'reviewerId', 'reviewerName', 'updatedAt'
            ])
          )
          ||
          // Action B: Substantiate outrageous act & atomically issue official MemberWarning
          (
            incoming().status == 'resolved_warned'
            && incoming().reviewStep == 'decision_prise'
            && incoming().warningIssued == true
            && 'warningId' in incoming()
            && incoming().gravityLevel in ['moderee', 'grave', 'critique']
            && incoming().decisionReason.size() >= 10
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reviewStep', 'evaluationCriteria', 'gravityLevel',
              'caseNotes', 'decisionReason', 'warningIssued', 'warningId',
              'reviewerId', 'reviewerName', 'reviewedAt', 'updatedAt'
            ])
            && incoming().reviewedAt == request.time
            && existsAfter(/databases/$(database)/documents/warnings/$(incoming().warningId))
          )
          ||
          // Action C: Dismiss case without sanction after case study
          (
            incoming().status == 'resolved_dismissed'
            && incoming().reviewStep == 'decision_prise'
            && incoming().warningIssued == false
            && !('warningId' in incoming())
            && incoming().decisionReason.size() >= 10
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reviewStep', 'evaluationCriteria', 'gravityLevel',
              'caseNotes', 'decisionReason', 'reviewerId', 'reviewerName',
              'reviewedAt', 'updatedAt'
            ])
            && incoming().reviewedAt == request.time
          )
          ||
          // Action D: Save or refresh AI pre-analysis on an active case
          (
            incoming().status == existing().status
            && incoming().reviewStep == existing().reviewStep
            && incoming().warningIssued == existing().warningIssued
            && 'aiAnalysis' in incoming()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'aiAnalysis', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // Official moderation warnings issued to members
    match /warnings/{warningId} {
      allow get: if isSignedIn()
        && isValidId(warningId)
        && (existing().targetUserId == request.auth.uid || isAdminEmail());
      allow list: if isSignedIn()
        && (resource.data.targetUserId == request.auth.uid || isAdminEmail());

      allow create: if isAdminEmail()
        && isValidId(warningId)
        && isValidMemberWarning(incoming())
        && incoming().warningId == warningId
        && incoming().issuedById == request.auth.uid
        && incoming().acknowledged == false
        && !('acknowledgedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/moderationCases/$(incoming().caseId))
        && get(/databases/$(database)/documents/moderationCases/$(incoming().caseId)).data.targetUserId == incoming().targetUserId
        && getAfter(/databases/$(database)/documents/moderationCases/$(incoming().caseId)).data.status == 'resolved_warned'
        && getAfter(/databases/$(database)/documents/moderationCases/$(incoming().caseId)).data.warningId == warningId;

      allow update: if isVerifiedUser()
        && isValidId(warningId)
        && existing().targetUserId == request.auth.uid
        && isValidMemberWarning(incoming())
        && incoming().warningId == existing().warningId
        && incoming().caseId == existing().caseId
        && incoming().targetUserId == existing().targetUserId
        && incoming().targetUserName == existing().targetUserName
        && incoming().category == existing().category
        && incoming().severity == existing().severity
        && incoming().justification == existing().justification
        && incoming().excerptSnapshot == existing().excerptSnapshot
        && incoming().issuedById == existing().issuedById
        && incoming().issuedByName == existing().issuedByName
        && incoming().createdAt == existing().createdAt
        && existing().acknowledged == false
        && incoming().acknowledged == true
        && incoming().acknowledgedAt == request.time
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'acknowledged', 'acknowledgedAt', 'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
